# ==============================================================================
# Keyprint — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any secret key.
# ==============================================================================

# --- Circle Modular Wallets (Passkeys + Gas Station on Arc Testnet) -----------
# Fixed client URL for every app; chain path (/arcTestnet) is appended in code.
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# Use your localhost Client Key locally, and your Vercel domain Client Key on Vercel.
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=

# --- Arc Testnet (Chain ID 5042002) -------------------------------------------
# Default public RPC, or swap in your QuickNode Arc Testnet endpoint for fast reads.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
# Optional server-side RPC override (defaults to NEXT_PUBLIC_ARC_RPC_URL)
ARC_RPC_URL=https://rpc.testnet.arc.io

# Deployed contract addresses on Arc Testnet (filled in after Foundry deploy)
NEXT_PUBLIC_KEYPRINT_REGISTRY_ADDRESS=
NEXT_PUBLIC_KEYPRINT_ESCROW_ADDRESS=

# --- Supabase (Postgres + Private Storage) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only: used to mint short-lived signed upload/download URLs
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=keyprint-private

# --- Anthropic AI (Server-side only) ------------------------------------------
# Used exclusively by /api/analyze with model "claude-opus-5-5"
ANTHROPIC_API_KEY=

# --- Settlement Keeper & Vercel Cron (Server-side only) -----------------------
# Plain EOA private key (0x...) holding a small amount of Arc Testnet USDC for gas
KEEPER_KEY=
# Random secret (>=16 chars) authorizing Vercel's daily cron backstop
CRON_SECRET=

# --- Foundry Deployment (Local Git Bash / WSL only — do NOT add to Vercel) ----
ARC_RPC=https://rpc.testnet.arc.io
DEPLOYER_KEY=
